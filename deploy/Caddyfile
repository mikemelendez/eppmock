eppmock.melendez.mx {
  encode zstd gzip

  # RDAP on the main host so CI/production tests do not require a separate DNS record.
  handle /rdap/* {
    uri strip_prefix /rdap
    reverse_proxy app:8090
  }

  handle {
    reverse_proxy app:8080
  }
}

# RDAP (RFC 7480 requires HTTPS). Point an A/AAAA record for this subdomain at the host.
rdap.eppmock.melendez.mx {
  encode zstd gzip

  reverse_proxy app:8090
}
