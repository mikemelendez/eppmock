RESET_HTTP_USER=admin
RESET_HTTP_PASSWORD=change-me
EPP_USERS=[{"clid":"melendez-admin","password":"admin-secret"},{"clid":"melendez-registrar","password":"registrar-secret"},{"clid":"melendez-tester","password":"tester-secret"}]
EPP_REPOSITORY_ID=ICANNRST
# RST epp-01/epp-03: terminate TLS on port 7000 (not via Caddy HTTP). Use a public CA cert whose SAN matches epp.hostName.
# EPP_TLS_CERT=/etc/letsencrypt/live/epp.example/fullchain.pem
# EPP_TLS_KEY=/etc/letsencrypt/live/epp.example/privkey.pem
# EPP_TLS_REQUIRE_CLIENT_CERT=true
# Bind RST client certificates by SHA-256 fingerprint (no colons), e.g.:
# EPP_USERS=[{"clid":"clid01","password":"...","clientCertSha256":"ab12..."},{"clid":"clid02","password":"...","clientCertSha256":"cd34..."}]
DNSSEC_KEY_PATH=/app/data/dnssec-keys.json
REGISTRY_TLD=melendez
WHOIS_HOST=0.0.0.0
WHOIS_PORT=43
