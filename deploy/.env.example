RESET_HTTP_USER=admin
RESET_HTTP_PASSWORD=change-me
EPP_HOSTNAME=eppmock.melendez.mx
EPP_REPOSITORY_ID=ICANNRST
# Registrar logins. After ICANN issues client certs, add clientCertSha256 on
# melendez-registrar and melendez-tester (lowercase hex, no colons):
#   ./deploy/fingerprint-cert.sh client.pem
# Those two clIDs are RST epp.clid01 / epp.clid02. Dashboard Auto login does not
# need fingerprints (it uses the localhost plaintext EPP port).
EPP_USERS=[{"clid":"melendez-admin","password":"admin-secret"},{"clid":"melendez-registrar","password":"registrar-secret"},{"clid":"melendez-tester","password":"tester-secret"}]
DNSSEC_KEY_PATH=/app/data/dnssec-keys.json
REGISTRY_TLD=melendez
WHOIS_HOST=0.0.0.0
WHOIS_PORT=43
